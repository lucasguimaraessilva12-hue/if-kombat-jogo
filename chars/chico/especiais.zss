#===============================================================================
# Chico - specials (animations in scripts/molde.py, ESPECIAIS["chico"])
#===============================================================================

#-------------------------------------------------------------------------------
# ENXADADA (frente, frente + soco baixo): raises the hoe, steps in and chops down.
# Blockable, knocks down. The hoe is an explod (anim 1015) bound to Chico, with the
# same timing as his animation (both generated by scripts/molde.py, enxadada()).
[StateDef 1010; type: S; movetype: A; physics: S; ctrl: 0; velset: 0, 0; anim: 1010; sprpriority: 2;]

if time = 0 {
	explod{anim: 1015; id: 1015; postype: p1; pos: 0, 0; bindtime: -1; removetime: -2;
		removeongethit: 1; ownpal: 1; sprpriority: 3}
}
if animElem = 2 {
	velSet{x: 2.5}
}
if animElem = 3 {
	velSet{x: 0}
	hitDef{
		attr: S, SA;
		damage: 85, 11;
		animtype: Hard;
		guardflag: MA;
		hitflag: MAF;
		priority: 4, Hit;
		pausetime: 12, 12;
		sparkxy: -10, -40;
		hitsound: 5, 2;
		guardsound: 6, 0;
		ground.type: High;
		ground.slidetime: 10;
		ground.hittime: 18;
		ground.velocity: -5, -3;
		air.velocity: -4, -4;
		air.hittime: 15;
		fall: 1;
		fall.recover: 0;
	}
}
if animTime = 0 {
	removeExplod{id: 1015}
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# MARMITA BUMERANGUE (tras, frente + soco alto): throws the lunchbox; it slows
# down, comes back (can hit again on the way back) and is caught by Chico.
[StateDef 1150; type: S; movetype: A; physics: S; ctrl: 0; velset: 0, 0; anim: 1150; sprpriority: 2;]

if animElem = 2 {
	helper{id: 1155; stateno: 1155; name: "Marmita"; pos: 28, -80; postype: p1; ownpal: 1; keyctrl: 0}
}
if animTime = 0 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# The lunchbox (helper)
[StateDef 1155; type: A; movetype: A; physics: N; ctrl: 0; anim: 1155; sprpriority: 3;]

if time = 0 {
	velSet{x: 6; y: 0}
}
velAdd{x: -0.2}
if time = 0 || time = 30 {
	hitDef{
		attr: S, SP;
		damage: 45, 6;
		animtype: Medium;
		guardflag: MA;
		hitflag: MAF;
		priority: 4, Hit;
		pausetime: 0, 10;
		sparkxy: 0, 0;
		hitsound: 5, 1;
		guardsound: 6, 0;
		ground.type: High;
		ground.slidetime: 8;
		ground.hittime: 14;
		ground.velocity: -3, 0;
		air.velocity: -3, -3;
	}
}
if (time > 30 && abs((root, pos x) - pos x) < 12) || time >= 120 {
	destroySelf{}
}
