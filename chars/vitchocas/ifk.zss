#===============================================================================
# IF Kombat - molde (shared code for the 6 fighters)
# This file is the hand-written part of ifk.zss; scripts/molde.py appends the
# basic moves (generated from the MOVES table) below it.
#===============================================================================

#-------------------------------------------------------------------------------
# Back to standing (type 0) or crouching (type 1) when the animation ends
[Function IFK_End(type)]
if animTime = 0 {
	changeState{value: 11 * $type; ctrl: roundState > 1}
}

#===============================================================================
# Win pose
#===============================================================================
[StateDef 180; type: S; movetype: I; physics: S; anim: 181; ctrl: 0; velset: 0, 0; sprpriority: 1;]

if animTime < -2 {
	assertSpecial{flag: roundnotover}
}
notHitBy{value: SCA; time: 1}

#===============================================================================
# Always executed
#===============================================================================
[StateDef -2]

# Guard = hold back (standing) or down-back (crouching), engine default.
# No blocking in the air.
assertSpecial{flag: noAirGuard}
if !isHelper {
	displayToClipboard{text: "IFK molde state=%d ctrl=%d"; params: stateNo, ctrl}
}

# CALA BOCA timer (set by Vitchocas' shout on hit; counts down on the shouter)
if !isHelper && map(calaboca) > 0 {
	mapAdd{map: "calaboca"; value: -1}
}
# Silenced fighters lose colour while they cannot use specials
if (enemyNear, map(calaboca)) > 0 {
	palFx{time: 2; color: 0}
}

#===============================================================================
# Basic moves (generated by scripts/molde.py from the MOVES table)
#===============================================================================

#-------------------------------------------------------------------------------
# soco alto
[StateDef 200; type: S; movetype: A; physics: S; juggle: 3; velset: 0, 0; ctrl: 0; anim: 200; sprpriority: 2;]

if animElem = 2 {
	hitDef{
		attr: S, NA;
		damage: 45, 6;
		animtype: Medium;
		guardflag: MA;
		hitflag: MAF;
		priority: 4, Hit;
		pausetime: 8, 8;
		sparkxy: -10, -90;
		hitsound: 5, 0;
		guardsound: 6, 0;
		ground.type: High;
		ground.slidetime: 8;
		ground.hittime: 12;
		ground.velocity: -4, 0;
		air.velocity: -2.4, -3;
		air.hittime: 15;
	}
}

call IFK_End(0);

